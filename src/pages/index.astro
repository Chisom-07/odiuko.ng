---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Odiuko Educational Services - Confident Learners!" currentPath="/">
  <section id="home">
    <div class="wrap hero">
      <div>
        <h1>Confident Learners!</h1>
        <p>Friendly one-on-one tutoring for Basic 1 to 6, at home or online. Same teacher, same lessons, your choice.</p>
        <div class="btns">
          <a class="btn" href="/contact">Book a consultation</a>
          <a class="btn alt" href="https://wa.me/2348167053677">Chat on WhatsApp</a>
        </div>
      </div>
      <div class="polaroid tape">
        <img class="hero-photo" src="/hero.jpg" alt="the teacher" width="340" height="260">
        <p class="hand">Hi, I’m Ruth. I know the look on a child’s face when it finally clicks.</p>
        <div class="sticker">Basic<br>1 to 6</div>
      </div>
    </div>
    <div class="strip" aria-hidden="true">
      <span>Math ★ Reading ★ Spelling ★ Homework help ★ At home ★ Online ★ Math ★ Reading ★ Spelling ★ Homework help ★ At home ★ Online ★ </span>
      <span>Math ★ Reading ★ Spelling ★ Homework help ★ At home ★ Online ★ Math ★ Reading ★ Spelling ★ Homework help ★ At home ★ Online ★ </span>
    </div>
    <div class="wrap">
      <h2>Pinned up this term</h2>
      <div class="line">
        <div class="pin blue"><span class="big">+ −</span><h3>Math</h3><p>Strong foundations, one step at a time, until the basics feel easy.</p></div>
        <div class="pin green"><span class="big">Aa</span><h3>Reading and spelling</h3><p>Fluent readers and confident spellers, with practice at your child’s level.</p></div>
        <div class="pin orange"><span class="big">✎</span><h3>Learning support</h3><p>Homework help and study routines that make school days calmer.</p></div>
      </div>
    </div>
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="path">
        <li><strong>Book a consultation.</strong> Tell us about your child and what you want to improve.</li>
        <li><strong>We find the starting point.</strong> A short check shows what your child knows and where they need help.</li>
        <li><strong>Sessions begin.</strong> At home or online, with a plan built around your child.</li>
        <li><strong>You stay informed.</strong> Regular updates show how your child is doing.</li>
      </ol>
    </div>
    <div class="wrap">
      <div class="pin yellow" style="--r:-1deg">
        <h2>At home or online?</h2>
        <p>Both give your child the same lessons and the same standard of teaching. Pick whichever fits your family’s week.</p>
        <a class="btn" href="/tutoring">See how tutoring works</a>
      </div>
    </div>
    <div class="wrap">
      <h2>Gold stars from parents</h2>
      <div class="grid">
        <div class="paper ph"><p class="stars">★★★★★</p><p>“[Testimonial text]”</p><p class="hand">[Parent name]</p></div>
        <div class="paper ph"><p class="stars">★★★★★</p><p>“[Testimonial text]”</p><p class="hand">[Parent name]</p></div>
      </div>
      <p><a href="/testimonials">More from parents</a> · <a href="/faq">Common questions</a> · <a href="/about">Meet the team</a></p>
    </div>
    <div class="wrap">
      <div class="pin purple" style="--r:1deg">
        <h2>Are you a school leader?</h2>
        <p>We also help schools with technology integration, curriculum development and instructional design.</p>
        <a class="btn" href="/schools" style="background:#F8F3E3;color:var(--ink);border-color:#F8F3E3">Explore school services</a>
      </div>
    </div>
  </section>
</BaseLayout>