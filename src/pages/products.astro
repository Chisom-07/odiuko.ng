---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Our Products - Odiuko Educational Services" currentPath="/products">
  <div class="wrap">
    <h1>Our products</h1>
    <p>Tools built by Odiuko to make teaching and learning easier.</p>
    <div class="line">
      <div class="pin yellow">
        <h3>LearnAid</h3>
        <p>An AI course generator that helps educators turn a topic into a structured course.</p>
        <a class="btn" href="https://learnaid.lovable.app">Open LearnAid</a>
      </div>
      <div class="pin blue">
        <h3>LearnQuest</h3>
        <p>A learning management system for organising lessons, learners and progress in one place.</p>
        <a class="btn" href="https://learnquest.odiuko.ng">Open LearnQuest</a>
      </div>
    </div>
  </div>
</BaseLayout>