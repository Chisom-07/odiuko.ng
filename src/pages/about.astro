---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About - Odiuko Educational Services" currentPath="/about">
  <div class="wrap">
    <h1>About Odiuko</h1>
    <p>Odiuko Educational Services helps children learn with confidence and helps schools teach better with technology and good design. We started out of our desire to ensure no child feels left behind or unsupported in their learning journey.</p>
    <h2>The team</h2>
    <div class="grid">
      <div class="paper ph"><h3>Ruth Ayogu</h3><p>Passionate about building strong learning foundations and helping primary pupils gain true academic confidence.</p></div>
      <div class="paper ph"><h3>Praise Asogwa</h3><p>Dedicated to making lessons engaging, clear and easy for students to understand.</p></div>
      <div class="paper ph"><h3>Ebere Uduji</h3><p>Focused on guiding students step-by-step through their daily academic journey.</p></div>
    </div>
  </div>
</BaseLayout>
