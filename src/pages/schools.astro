---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="For Schools - Odiuko Educational Services" currentPath="/schools">
  <div class="wrap">
    <h1>For schools</h1>
    <p>We help schools use technology well and design learning that works for teachers and pupils.</p>
    <div class="line">
      <div class="pin purple">
        <h3>Strategic tech integration</h3>
        <ul class="tick">
          <li>Review how technology is used today</li>
          <li>Choose and set up tools that fit your goals</li>
          <li>Train teachers and staff to use them</li>
        </ul>
      </div>
      <div class="pin teal">
        <h3>Instructional design and curriculum development</h3>
        <ul class="tick">
          <li>Curriculum planning and lesson design</li>
          <li>eLearning courses and digital resources</li>
          <li>Assessments tied to learning goals</li>
        </ul>
      </div>
    </div>
    <p>We build our own tools too. <a href="/products">See our products</a>.</p>
    <a class="btn" href="/contact">Talk to us about your school</a>
  </div>
</BaseLayout>