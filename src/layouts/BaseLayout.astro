---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  currentPath?: string;
}

const { title = "Odiuko Educational Services", currentPath = "/" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap">
<style is:global>
:root{--bg:#F8F3E3;--card:#fffdf5;--text:#2b2410;--muted:#5d5230;--brown:#6F5720;--yellow:#DFB137;--blue:#61BCD1;--green:#9AB75A;--orange:#C65C32;--purple:#655089;--teal:#50A882;--ink:#2b1f05;--line:#e0d5b0;--rule:rgba(97,188,209,.22);--mar:rgba(198,92,50,.4);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1c1809;--card:#2a2412;--text:#f3ecd4;--muted:#cfc39b;--line:#4a4023;--rule:rgba(97,188,209,.12)}}
:root[data-theme="dark"]{--bg:#1c1809;--card:#2a2412;--text:#f3ecd4;--muted:#cfc39b;--line:#4a4023;--rule:rgba(97,188,209,.12)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;color:var(--text);font:17px/1.65 Arial,Helvetica,sans-serif;background:linear-gradient(90deg,transparent 12px,var(--mar) 12px 14px,transparent 14px),repeating-linear-gradient(transparent 0 31px,var(--rule) 31px 32px),var(--bg);overflow-x:hidden}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:10}
h1,h2,h3{font-family:Georgia,'Times New Roman',serif;line-height:1.1;margin:0 0 .5em}
h1{font-size:clamp(2.6rem,10vw,5.4rem);letter-spacing:-.02em}h2{font-size:clamp(1.8rem,6vw,3rem)}h3{font-size:1.4rem}
p{margin:0 0 1em;max-width:60ch}a{color:inherit}
.hand{font-family:'Caveat','Comic Sans MS',cursive;font-size:1.6rem;line-height:1.25;color:var(--purple)}
@media (prefers-color-scheme:dark){.hand{color:var(--yellow)}}
:focus-visible{outline:3px solid var(--purple);outline-offset:3px}
[hidden]{display:none!important}
header{position:sticky;top:0;z-index:5;background:var(--bg);padding-top:env(safe-area-inset-top,0px);border-bottom:2px dashed var(--line)}
.bar{max-width:1100px;margin:0 auto;padding:.7rem 1.2rem 0.7rem 1.6rem;display:flex;gap:.8rem;align-items:center;justify-content:space-between;flex-wrap:wrap}
.logo{display:flex;align-items:center;text-decoration:none}
.logo img{height:56px;width:auto;display:block}
@media (min-width:700px){.logo img{height:72px}}
nav{display:flex;gap:.45rem;overflow-x:auto;max-width:100%;padding:.2rem}
nav a{text-decoration:none;font-size:.92rem;padding:.4rem .9rem;border-radius:99px;white-space:nowrap;border:2px solid var(--line)}
nav a[aria-current="page"]{background:var(--brown);border-color:var(--brown);color:#F8F3E3}
.wrap{max-width:1100px;margin:0 auto;padding:2.6rem 1.2rem 2.6rem 1.8rem}
.hero{display:grid;gap:2.4rem;align-items:center;grid-template-columns:repeat(auto-fit,minmax(290px,1fr))}
.hero p{font-size:1.2rem}
.btns{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.3rem}
.btn{display:inline-block;padding:.9rem 1.5rem;border-radius:99px;background:var(--brown);color:#F8F3E3;font-weight:700;text-decoration:none;border:3px solid var(--brown)}
.btn.alt{background:transparent;color:var(--text);border-color:var(--text)}
.polaroid{position:relative;background:#fff;padding:.9rem .9rem 1rem;transform:rotate(3deg);box-shadow:5px 6px 0 rgba(111,87,32,.35);max-width:360px;justify-self:center;color:#2b1f05}
.polaroid .hero-photo{display:block;width:100%;height:260px;object-fit:cover}
.polaroid .hand{color:#2b1f05;margin:.7rem 0 0;font-size:1.5rem}
.tape::before{content:"";position:absolute;top:-14px;left:50%;width:90px;height:28px;margin-left:-45px;background:rgba(223,177,55,.75);transform:rotate(-4deg)}
.sticker{position:absolute;right:-14px;bottom:-18px;width:84px;height:84px;border-radius:50%;background:var(--yellow);color:#2b1f05;display:grid;place-items:center;text-align:center;font:700 .85rem/1.1 Arial;transform:rotate(-10deg)}
.strip{background:var(--brown);color:#F8F3E3;overflow:hidden;white-space:nowrap;transform:rotate(-1.2deg);border-block:4px solid var(--yellow);margin:1rem -1rem;padding:.7rem 0;font:700 1.4rem Georgia,serif}
.strip span{display:inline-block;padding-right:2rem;animation:run 26s linear infinite}
@keyframes run{to{transform:translateX(-100%)}}
@media (prefers-reduced-motion:reduce){.strip span{animation:none}}
.line{position:relative;display:grid;gap:1.6rem;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));padding-top:2rem;margin:1.2rem 0}
.line::before{content:"";position:absolute;top:.4rem;left:-1rem;right:-1rem;border-top:3px dashed var(--brown)}
.pin{position:relative;padding:2rem 1.6rem 1.6rem;color:var(--ink);transform:rotate(var(--r,-2deg));box-shadow:4px 5px 0 rgba(111,87,32,.3)}
.pin:nth-child(2){--r:1.8deg}.pin:nth-child(3){--r:-1deg}
.pin::before{content:"";position:absolute;top:-14px;left:50%;width:70px;height:26px;margin-left:-35px;background:rgba(255,253,245,.8);transform:rotate(3deg);border:1px solid rgba(111,87,32,.3)}
.pin .big{font:700 3rem Georgia,serif;display:block;margin-bottom:.2rem}.pin p:last-child{margin:0}
.blue{background:var(--blue)}.green{background:var(--green)}.orange{background:var(--orange)}.yellow{background:var(--yellow)}.purple{background:var(--purple);color:#F8F3E3}.teal{background:var(--teal)}
.paper{background:var(--card);border:2px solid var(--line);border-radius:6px;padding:1.4rem;box-shadow:3px 4px 0 rgba(111,87,32,.18)}
.paper.ph{border-style:dashed}
.grid{display:grid;gap:1.2rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));margin:1.2rem 0}
.stars{color:var(--yellow);font-size:1.5rem;letter-spacing:.1em;text-shadow:0 0 1px #2b1f05}
ol.path{list-style:none;padding:0;margin:1.4rem 0;display:grid;gap:1.2rem;counter-reset:s}
ol.path li{counter-increment:s;padding-left:4rem;position:relative;min-height:3rem}
ol.path li::before{content:counter(s);position:absolute;left:0;top:-.2rem;width:3rem;height:3rem;border-radius:50%;background:var(--yellow);color:var(--ink);display:grid;place-items:center;font:700 1.5rem Georgia,serif;transform:rotate(-8deg)}
ul.tick{padding-left:1.2rem}ul.tick li{margin-bottom:.5rem}
details{background:var(--card);border:2px solid var(--line);border-radius:6px;padding:.9rem 1.3rem;margin-bottom:.7rem}
summary{cursor:pointer;font-weight:700}details p{margin:.7rem 0 0}
.muted{color:var(--muted)}
footer{background:var(--brown);color:#F8F3E3;margin-top:2rem;border-top:6px dashed var(--yellow)}
footer .wrap{display:grid;gap:1.2rem;grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}
footer a{display:block;text-decoration:none;margin-bottom:.3rem}footer p{margin:0 0 .3rem}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
</style>
</head>
<body>
  <Header currentPath={currentPath} />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>