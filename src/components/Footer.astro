<style>
  footer {
    background: linear-gradient(180deg, #4a3a14 0%, #6F5720 100%);
    color: #F5F5DC;
    padding: 3rem 4rem 1.5rem 4rem;
  }

  .wrap {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(245, 245, 245, 0.2);
  }

  .wrap div {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .wrap h3 {
    margin: 0;
    font-family: Georgia, serif;
  }

  .wrap div:not(:first-child) h3 {
    font: 600 0.75rem Arial, sans-serif;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #DFB137;
  }

  .wrap p {
    margin: 0;
  }

  .tagline {
    opacity: 0.85;
  }

  footer a {
    color: #F5F5DC;
    text-decoration: none;
    opacity: 0.8;
  }

  footer a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .social {
    flex-direction: row !important;
    gap: 0.75rem !important;
    margin-top: 0.25rem;
  }

  .social a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(245, 245, 220, 0.35);
    display: grid;
    place-items: center;
    opacity: 1;
  }

  .social a:hover {
    color: #DFB137;
    border-color: #DFB137;
    text-decoration: none;
  }

  .bottom {
    margin: 1.5rem 0 0 0;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8rem;
    opacity: 0.75;
  }

  .bottom p {
    margin: 0;
  }

  @media (max-width: 700px) {
    footer { padding: 2rem 1.5rem 1.5rem 1.5rem; }
    .wrap { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .wrap > div:first-child { grid-column: 1 / -1; }
    .bottom { flex-direction: column; }
  }
</style>
